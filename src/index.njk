---
layout: base.njk
bodyClass: home
---
{% from "macros.njk" import media, art, icon, arrow %}
{% set active = collections.listings | withoutStatus("Sold") %}
{% set stats = sales | salesStats %}

<section class="hero">
  <div class="hero-art" aria-hidden="true">{{ art("rainier") }}</div>
  <div class="wrap hero-grid">
    <div class="hero-text">
      <p class="kicker">Seattle · The Eastside · South Sound</p>
      <h1 class="h-display">Buy, sell, build, invest.<br><em>To the Nth degree.</em></h1>
      <p class="lede">A boutique team of agents who build, remodel, and invest in this market ourselves, so the advice you get accounts for what a property can become.</p>
      <div class="btn-row"><a class="btn" href="{{ site.idxSearchUrl or '/listings/' }}">Explore properties {{ arrow() }}</a><a class="link-arrow" href="/home-value/">What's my home worth? {{ arrow() }}</a></div>
    </div>
    <div class="hero-collage">
      {{ media(site.photos.hero, "Puget Sound home at dusk", "hc-main framed", true, "(min-width: 900px) 46vw, 100vw", "modern") }}
      {{ media(site.photos.heroDetail, "Interior detail", "hc-inset", false, "(min-width: 900px) 18vw, 40vw", "plan") }}
      <span class="hc-caption">Est. in the Puget Sound</span>
      <div class="hc-compass" aria-hidden="true">{{ art("compass") }}</div>
    </div>
  </div>
</section>

<div class="marquee" aria-hidden="true"><div class="marquee-track">{% for i in range(0, 2) %}<span>Seattle</span><span>Bellevue</span><span>Kirkland</span><span>Redmond</span><span>Renton</span><span>Kent</span><span>Federal Way</span><span>Tacoma</span><span>Mercer Island</span><span>West Seattle</span>{% endfor %}</div></div>

<section class="section">
  <div class="wrap">
    <div class="section-head center-head"><div><p class="kicker">Start here</p><h2>Welcome in. <em>Where are you headed?</em></h2></div></div>
    <div class="paths">
      {% for p in [
        ["buy","I","Buy","Find your next home","/buyers/"],
        ["sell","II","Sell","Sell for what it's worth","/sellers/"],
        ["invest","III","Invest","Build a portfolio","/investors/"],
        ["build","IV","Build","Develop land","/builders/"]
      ] %}
      <a class="path-card" href="{{ p[4] }}"><span class="path-num">{{ p[1] }}</span>{{ icon(p[0]) }}<span class="label">{{ p[2] }}</span><strong>{{ p[3] }}</strong><span class="path-go">Read the guide {{ arrow() }}</span></a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section paper">
  <div class="wrap split split-media">
    <div class="collage">
      {{ media(site.photos.intro, "The Nth Properties team", "c-main framed", false, "(min-width: 820px) 36vw, 90vw", "craftsman") }}
      {{ media(site.photos.introDetail, "Detail", "c-inset", false, "(min-width: 820px) 18vw, 45vw", "plan") }}
    </div>
    <div>
      <p class="kicker">A boutique real estate team</p>
      <h2>Local knowledge. <em>Broader perspective.</em></h2>
      <p class="dropcap">Most of our business comes from referrals, which means every client gets the kind of care that earns one. We've helped clients buy a first home, grow into a first investment, and keep building from there.</p>
      <p>Between us we've built, remodeled, developed land, and run long- and short-term rentals, including our own. That shows up in every recommendation.</p>
      <div class="signature">{% for m in team %}<span>{{ m.name }}</span>{% endfor %}</div>
      <a class="link-arrow" href="/about/">Our story {{ arrow() }}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head"><div><p class="kicker">Now presenting</p><h2>On the market <em>now.</em></h2></div><div class="carousel-nav"><button type="button" data-scroll="-1" aria-label="Previous">{{ arrow() }}</button><button type="button" data-scroll="1" aria-label="Next">{{ arrow() }}</button></div></div>
    {% if active.length %}
    <div class="carousel" data-carousel>{% for item in active %}{% include "card.njk" %}{% endfor %}</div>
    {% else %}
    <div class="empty-state"><h3>New listings are on the way.</h3><p>Tell us what you're looking for and we'll send matches, including homes before they hit the market.</p><a class="btn" href="/buy/">Start a custom search</a></div>
    {% endif %}
    <p class="after-carousel"><a class="link-arrow" href="/listings/">All our listings {{ arrow() }}</a>{% if site.idxSearchUrl %}<a class="link-arrow" href="{{ site.idxSearchUrl }}">Search every home on the market {{ arrow() }}</a>{% endif %}</p>
  </div>
</section>

<section class="feature-band">
  {{ media(site.photos.valuation, "", "fb-bg", false, "100vw", "craftsman") }}
  <div class="wrap"><div class="fb-card">
    <p class="kicker">For sellers</p>
    <h2>What is your home <em>really</em> worth?</h2>
    <p>Online estimates can't see the remodel, the view, or the block. We price from real comparable sales and walk the home with a builder's eye.</p>
    <div class="btn-row"><a class="btn" href="/home-value/">Request a valuation {{ arrow() }}</a><a class="link-arrow" href="/sellers/">Seller guide {{ arrow() }}</a></div>
  </div></div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head"><div><p class="kicker">Track record</p><h2>Every kind of home, <em>recently sold.</em></h2></div><a class="link-arrow" href="/sold/">Full sales history {{ arrow() }}</a></div>
    {% if sales.length %}
    <div class="stat-bar">
      <div><strong>{{ stats.volume }}</strong><span>In closed sales</span></div>
      <div><strong>{{ stats.count }}</strong><span>Homes sold</span></div>
      <div><strong>{{ stats.avg }}</strong><span>Average price</span></div>
      <div><strong>{{ stats.cities }}</strong><span>Cities served</span></div>
    </div>
    <div class="map-wrap framed-soft"><div class="map" data-map='{{ sales | jsonify }}'></div><div class="map-legend"><span class="dot"></span> Closed sale</div></div>
    {% endif %}
  </div>
</section>

<section class="section paper">
  <div class="wrap">
    <div class="section-head"><div><p class="kicker">Neighborhoods</p><h2>Seattle, the Eastside <em>&amp; South Sound.</em></h2></div><a class="link-arrow" href="/areas/">All neighborhoods {{ arrow() }}</a></div>
    <div class="area-gallery">{% for a in areas %}<a class="area-tile" href="/areas/{{ a.slug }}/">{{ media(a.photo, a.name, "area-bg", false, "(min-width: 1000px) 25vw, 50vw", ["skyline","modern","craftsman","rainier"][loop.index0 % 4]) }}<span class="area-text"><span class="label">{{ a.county }}</span><strong>{{ a.name }}</strong></span></a>{% endfor %}</div>
  </div>
</section>

{% if site.showTestimonials %}
<section class="section">
  <div class="wrap narrow center">
    <p class="kicker center-k">Client words</p>
    <div class="quotes" data-quotes>{% for t in testimonials %}<blockquote class="quote{% if loop.first %} on{% endif %}"><p>“{{ t.quote }}”</p><footer class="label">{{ t.name }} · {{ t.detail }}</footer></blockquote>{% endfor %}</div>
  </div>
</section>
{% endif %}

<section class="section">
  <div class="wrap">
    <div class="section-head"><div><p class="kicker">Insights</p><h2>Read the market <em>with us.</em></h2></div></div>
    <div class="insight-grid">
      <a class="insight-feature" href="/market-reports/">
        {{ media(site.photos.report, "", "if-bg", false, "(min-width: 900px) 50vw, 100vw", "rainier") }}
        <span class="if-text"><span class="label">Quarterly</span><strong>Puget Sound Market Report</strong><span class="link-arrow">Read the latest {{ arrow() }}</span></span>
      </a>
      <div class="insight-list">
        {% for p in collections.posts | head(3) %}<a class="post-row" href="{{ p.url }}"><span class="label">{{ p.date | longDate }}</span><h3>{{ p.data.title }}</h3></a>{% else %}<p class="muted">Blog posts will appear here.</p>{% endfor %}
        <div class="report-signup"><p class="label">Get the report by email</p>{% set formType = "newsletter-light" %}{% include "form.njk" %}</div>
      </div>
    </div>
  </div>
</section>

{% include "cta.njk" %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"RealEstateAgent","name":"{{ site.name }}","url":"{{ site.url }}","telephone":"{{ site.phone }}","areaServed":[{% for a in areas %}"{{ a.name }}, WA"{% if not loop.last %},{% endif %}{% endfor %}]}</script>

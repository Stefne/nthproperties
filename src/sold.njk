---
layout: base.njk
title: Track Record
permalink: /sold/
summary: Homes Nth Properties has sold across Seattle, the Eastside, and the South Sound.
---
{% set stats = sales | salesStats %}
{% set soldListings = collections.listings | withStatus("Sold") %}
<section class="page-head"><div class="wrap"><p class="kicker">Sold properties</p><h1 class="h-hero">Every kind of home, <span class="accent-text">recently sold.</span></h1></div></section>
<section class="section tight">
  <div class="wrap">
    {% if sales.length %}
    <div class="stat-bar top">
      <div><strong>{{ stats.volume }}</strong><span>In closed sales</span></div>
      <div><strong>{{ stats.count }}</strong><span>Homes sold</span></div>
      <div><strong>{{ stats.avg }}</strong><span>Average sale price</span></div>
      <div><strong>{{ stats.cities }}</strong><span>Cities served</span></div>
    </div>
    <div class="map-wrap"><div class="map tall" data-map='{{ sales | jsonify }}'></div></div>
    {% endif %}
    {% if soldListings.length %}
    <h2 class="h3 mt">Featured sales</h2>
    <div class="grid cards">{% for item in soldListings %}{% include "card.njk" %}{% endfor %}</div>
    {% endif %}
    {% if sales.length %}
    <h2 class="h3 mt">Sales history</h2>
    <div class="table-wrap"><table class="sales-table">
      <thead><tr><th>Address</th><th>City</th><th>Price</th><th>Closed</th><th>Represented</th><th>Details</th></tr></thead>
      <tbody>{% for s in sales %}<tr><td>{{ s.address }}</td><td>{{ s.city }}</td><td>${{ s.price | num }}</td><td class="mono">{{ s.date }}</td><td>{{ s.side }}</td><td class="muted">{{ s.type }}{% if s.beds %} · {{ s.beds }} bd{% endif %}{% if s.sqft %} · {{ s.sqft | num }} sf{% endif %}</td></tr>{% endfor %}</tbody>
    </table></div>
    {% endif %}
  </div>
</section>
{% include "cta.njk" %}

{# ===== Architectural line art. Stroke inherits currentColor. ===== #}
{% macro art(name, cls="") %}
<svg class="art art-{{ name }} {{ cls }}" viewBox="0 0 400 240" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{% if name == "rainier" %}
<path d="M0 200 60 168l30 10 40-34 26 12 44-58 18 14 22-26 26 30 20-6 30 34 22-6 62 62"/>
<path d="M180 92l14 16 8-8 10 14 10-12 8 10" /><path d="M196 104l-6 18M214 110l4 16M232 116l-8 14"/>
<path d="M0 214h400" opacity=".5"/><path d="M0 222c40-4 80 4 120 0s80-6 120-2 100 4 160 0" opacity=".35"/>
{% elif name == "skyline" %}
<path d="M0 214h400"/>
<path d="M60 214v-80h22v80M90 214v-104h26v104M124 214v-62h18v62M150 214v-128h30v128M188 214v-90h20v90"/>
<path d="M264 214V116M258 116h12M256 110h16l-2-6h-12zM250 104c4-8 24-8 28 0zM262 98v-14M264 84l2-10"/>
<path d="M216 214v-70h16v70M300 214v-96h24v96M330 214v-58h20v58M356 214v-40h22v40"/>
<path d="M156 98h18M156 110h18M156 122h18M96 124h14M96 136h14M306 132h12M306 144h12" opacity=".5"/>
<path d="M20 160l40-24 40 18 60-40 50 24 60-30 60 26 50-20 20 10" opacity=".25"/>
{% elif name == "craftsman" %}
<path d="M60 214h280"/><path d="M90 214v-96h220v96"/><path d="M70 122 200 50l130 72"/><path d="M110 112 200 62l90 50"/>
<path d="M90 160h220"/><path d="M110 160v54M150 160v54M250 160v54M290 160v54" opacity=".6"/>
<rect x="180" y="168" width="40" height="46"/><path d="M200 168v46"/>
<rect x="120" y="126" width="28" height="22"/><rect x="252" y="126" width="28" height="22"/><path d="M134 126v22M266 126v22"/>
<path d="M186 92h28v18h-28zM200 92v18"/><path d="M240 64v-20h16v28" />
{% elif name == "modern" %}
<path d="M40 214h320"/><path d="M60 214v-70h150v70"/><path d="M40 144h190"/><path d="M150 144V92h190v52"/><path d="M130 92h230"/>
<path d="M170 100v36h150v-36" opacity=".6"/><path d="M210 100v36M260 100v36" opacity=".6"/>
<path d="M80 156v58h50v-58zM105 156v58" opacity=".6"/><path d="M230 214v-70h110v70"/><path d="M250 160h70v54" opacity=".6"/>
<path d="M300 92V70h18v22"/>
{% elif name == "plan" %}
<rect x="60" y="40" width="280" height="170"/><path d="M60 120h120M180 40v60M180 130v80M250 120h90M250 120v90"/>
<path d="M180 100a30 30 0 0 1 30 30" opacity=".6"/><path d="M180 100v30" opacity=".6"/>
<path d="M220 120a30 30 0 0 0 30-30" opacity=".6"/>
<path d="M90 60h60v30H90z" opacity=".4"/><circle cx="295" cy="165" r="18" opacity=".4"/><path d="M100 150h40v40h-40z" opacity=".4"/>
<path d="M60 26h280M60 22v8M340 22v8M180 22v8" opacity=".5"/><path d="M350 40v170M346 40h8M346 210h8" opacity=".5"/>
{% elif name == "compass" %}
<circle cx="200" cy="120" r="78"/><circle cx="200" cy="120" r="64" opacity=".5"/>
<path d="M200 30v180M110 120h180" opacity=".35"/><path d="M200 46l12 74-12 74-12-74z"/><path d="M200 46v148" opacity=".5"/>
<path d="M126 120l74-10 74 10-74 10z" opacity=".6"/><path d="M193 24v-12l14 12v-12"/>
{% endif %}
</svg>
{% endmacro %}

{# ===== Photo slot. Empty slots show line art on stone, so the page still looks finished. ===== #}
{% macro media(src, alt, cls="", eager=false, sizes="100vw", artName="craftsman") %}
{% set real = src | photo %}
<div class="media {{ cls }}{% if not real %} media-empty{% endif %}">
  {% if real %}<img src="{{ real }}" alt="{{ alt }}" sizes="{{ sizes }}"{% if eager %} loading="eager" fetchpriority="high"{% endif %}>{% else %}{{ art(artName) }}{% endif %}
</div>
{% endmacro %}

{% macro arrow() %}<svg class="arr" viewBox="0 0 24 12" aria-hidden="true"><path d="M0 6h22M17 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1"/></svg>{% endmacro %}

{# Path-chooser icons reuse the line art #}
{% macro icon(name) %}{{ art({buy:"craftsman", sell:"modern", invest:"skyline", build:"plan"}[name], "icon") }}{% endmacro %}

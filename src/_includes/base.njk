<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set pageTitle = (title + " | " + site.name) if title else (site.name + " | Greater Seattle Real Estate") %}
{% set pageDesc = summary or description or site.description %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ (photos[0] if photos else '/assets/img/og.png') }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#14213D">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
{% block head %}{% endblock %}
</head>
<body class="{{ bodyClass }}">
<a class="skip" href="#main">Skip to content</a>
{% set searchUrl = site.idxSearchUrl or "/buy/" %}
<header class="site-header" data-header>
  <div class="wrap header-row">
    <a class="logo" href="/" aria-label="{{ site.name }} home"><span class="logo-mark">N<sup>th</sup></span><span class="logo-text">Properties</span></a>
    <nav id="nav" class="nav" aria-label="Main">
      <div class="nav-group"><button type="button" class="nav-top">Buy</button>
        <div class="nav-menu"><a href="{{ searchUrl }}">Search all homes</a><a href="/listings/">Our listings</a><a href="/buy/">Custom search request</a><a href="/areas/">Neighborhoods</a></div></div>
      <div class="nav-group"><button type="button" class="nav-top">Sell</button>
        <div class="nav-menu"><a href="/home-value/">What's my home worth?</a><a href="/sold/">Sold properties</a>{% if site.showDesign %}<a href="/design/">Staging &amp; design</a>{% endif %}</div></div>
      <div class="nav-group"><button type="button" class="nav-top">Invest &amp; Build</button>
        <div class="nav-menu"><a href="/services/#investing">Investing</a><a href="/services/#property-management">Property management</a><a href="/services/#land-development">Land &amp; development</a></div></div>
      <a class="nav-top" href="/sold/">Track Record</a>
      <a class="nav-top" href="/blog/">Blog</a>
      <a class="nav-top" href="/team/">Team</a>
      <a class="nav-phone" href="tel:{{ site.phone | tel }}">{{ site.phone }}</a>
      <a class="btn btn-sm" href="/contact/?topic=consultation">Let's talk</a>
    </nav>
    <button class="nav-toggle" aria-expanded="false" aria-controls="nav"><span></span><span></span><span class="sr">Menu</span></button>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap footer-top">
    <a class="logo" href="/"><span class="logo-mark">N<sup>th</sup></span><span class="logo-text">Properties</span></a>
    <p class="footer-tag">{{ site.tagline }}</p>
  </div>
  <div class="wrap footer-grid">
    <div>
      <h4>Contact</h4>
      <a href="tel:{{ site.phone | tel }}">{{ site.phone }}</a>
      <a href="sms:{{ site.phone | tel }}">Text us</a>
      {% if site.email %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}
      <div class="social">{% for k, v in site.social %}{% if v %}<a href="{{ v }}" rel="noopener" target="_blank">{{ k | capitalize }}</a>{% endif %}{% endfor %}</div>
    </div>
    <div>
      <h4>Explore</h4>
      <a href="/listings/">Listings</a><a href="/sold/">Track record</a><a href="/home-value/">Home valuation</a><a href="/buy/">Buyer search</a><a href="/services/">Services</a><a href="/team/">Team</a><a href="/blog/">Blog</a>{% if site.showDesign %}<a href="/design/">Staging &amp; design</a>{% endif %}
    </div>
    <div>
      <h4>Areas</h4>
      {% for a in areas %}<a href="/areas/{{ a.slug }}/">{{ a.name }}</a>{% endfor %}
    </div>
    <div>
      <h4>Market Report</h4>
      <p class="fine-light">Quarterly Puget Sound market notes. No spam.</p>
      {% set formType = "newsletter" %}{% include "form.njk" %}
    </div>
  </div>
  <div class="wrap legal">
    <p><strong>{{ site.brokerage or "[BROKERAGE NAME]" }}</strong>{% if site.brokerageAddress %} · {{ site.brokerageAddress }}{% endif %}</p>
    <p class="eho"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2 1 10h3v11h16V10h3L12 2zm-5 9h10v2H7v-2zm0 4h10v2H7v-2z"/></svg> Equal Housing Opportunity</p>
    <p>Information deemed reliable but not guaranteed. &copy; {{ site.year }} {{ site.name }}.</p>
  </div>
</footer>
{% block after %}{% endblock %}
<script src="/assets/js/main.js" defer></script>
{% if site.cfAnalyticsToken %}<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfAnalyticsToken }}"}'></script>{% endif %}
</body>
</html>

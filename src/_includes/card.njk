{% set d = item.data %}{% set oh = d.openHouses | upcoming %}
<article class="card" data-status="{{ d.status }}" data-city="{{ d.city }}" data-beds="{{ d.beds or 0 }}" data-price="{{ d.price or 0 }}">
  <a href="{{ item.url }}" class="card-img">
    <img src="{{ d.photos[0] if d.photos else '/assets/img/placeholder.svg' }}" alt="{{ d.title }}" sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw">
    <span class="badge badge-{{ d.status | slug2 }}">{{ d.status }}</span>
    {% if oh.length %}<span class="badge badge-oh">Open {{ oh[0].date | shortDate }}</span>{% endif %}
  </a>
  <div class="card-body">
    <p class="card-loc">{{ d.neighborhood or d.city }}, {{ d.state or "WA" }}</p>
    <h3><a href="{{ item.url }}">{{ d.title }}</a></h3>
    <p class="facts"><span class="price">{{ d.price | money }}</span>{% if d.beds %}<span>{{ d.beds }} BD</span>{% endif %}{% if d.baths %}<span>{{ d.baths }} BA</span>{% endif %}{% if d.sqft %}<span>{{ d.sqft | num }} SF</span>{% endif %}</p>
  </div>
</article>

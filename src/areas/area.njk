---
layout: base.njk
pagination: { data: areas, size: 1, alias: area }
permalink: "/areas/{{ area.slug }}/"
overHero: true
eleventyComputed:
  title: "{{ area.name }} Real Estate"
  summary: "{{ area.blurb }}"
---
{% from "macros.njk" import media %}
<section class="page-hero">
  {{ media(area.photo, area.name, "page-hero-bg", true) }}
  <div class="wrap page-hero-inner"><p class="eyebrow light">{{ area.county }}</p><h1>{{ area.name }}</h1></div>
</section>
<section class="section tight"><div class="wrap split">
  <div><p class="lede dark">{{ area.blurb }}</p></div>
  <div><h2 class="h3">How we help in {{ area.name }}</h2><ul class="checks">{% for p in area.points %}<li>{{ p }}</li>{% endfor %}</ul>
  <div class="btn-row"><a class="btn" href="/home-value/">{{ area.name }} home value</a><a class="btn btn-outline" href="/buy/">Search {{ area.name }}</a></div></div>
</div></section>
{% set local = collections.listings | inCity(area.name) %}
{% if local.length %}
<section class="section ivory"><div class="wrap"><h2>{{ area.name }} listings</h2><div class="grid cards">{% for item in local %}{% include "card.njk" %}{% endfor %}</div></div></section>
{% endif %}
{% include "cta.njk" %}

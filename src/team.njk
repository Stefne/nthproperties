---
layout: base.njk
title: Our Team
permalink: /team/
---
<section class="page-head"><div class="wrap"><p class="kicker">Who we are</p><h1 class="h-hero">A boutique team, <span class="accent-text">by design.</span></h1><p class="lede">You work directly with the partners, from the first conversation through closing and beyond.</p></div></section>
<section class="section tight"><div class="wrap">
  {% for m in team %}{% set mp = m.photo | photo %}
  <div class="member">
    <div class="member-photo">{% if mp %}<img src="{{ mp }}" alt="{{ m.name }}" sizes="(min-width: 720px) 40vw, 100vw">{% else %}<span>{{ m.name | initials }}</span>{% endif %}</div>
    <div>
      <p class="kicker">{{ m.role }}</p>
      <h2>{{ m.name }}</h2>
      <p>{{ m.bio }}</p>
      <p class="member-contact">{% if m.phone %}<a href="tel:{{ m.phone | tel }}">{{ m.phone }}</a>{% endif %}{% if m.email %}<a href="mailto:{{ m.email }}">{{ m.email }}</a>{% endif %}{% if m.license %}<span>WA License #{{ m.license }}</span>{% endif %}</p>
    </div>
  </div>
  {% endfor %}
</div></section>
{% include "cta.njk" %}

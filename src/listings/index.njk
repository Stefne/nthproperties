---
layout: base.njk
title: Listings
permalink: /listings/
summary: Homes and properties represented by Nth Properties across Greater Seattle and the South Sound.
---
{% from "macros.njk" import art as lineArt %}
<section class="page-head art-head"><div class="wrap"><p class="kicker">Properties</p><h1 class="h-hero">Our listings. <span class="accent-text">Your opportunity.</span></h1></div>{{ lineArt("modern", "head-art") }}</section>
<section class="section tight">
  <div class="wrap">
    {% if collections.listings.length %}
    <div class="tabs" role="tablist" data-tabs>
      <button role="tab" data-status="" aria-selected="true">All</button><button role="tab" data-status="Active">Active</button><button role="tab" data-status="Coming Soon">Coming Soon</button><button role="tab" data-status="Pending">Pending</button><button role="tab" data-status="Sold">Sold</button>
    </div>
    <form class="filters" data-filters onsubmit="return false">
      <input type="hidden" name="status" value="">
      <label>City<select name="city"><option value="">All</option>{% for a in areas %}<option>{{ a.name }}</option>{% endfor %}</select></label>
      <label>Min beds<select name="beds"><option value="0">Any</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select></label>
      <label>Max price<select name="price"><option value="0">Any</option><option value="600000">$600K</option><option value="900000">$900K</option><option value="1300000">$1.3M</option><option value="2000000">$2M</option><option value="3000000">$3M</option></select></label>
    </form>
    <div class="grid cards" data-results>{% for item in collections.listings %}{% include "card.njk" %}{% endfor %}</div>
    <p class="empty" data-empty hidden>No listings match those filters. <a href="/buy/">Tell us what you want</a> and we'll find it.</p>
    {% endif %}
    <div class="empty-state mt">
      <h3>Not seeing the right home?</h3><p>Many of the best homes trade before they're widely marketed. Tell us what you want and we'll watch for it.</p><a class="btn" href="/buy/">Start a Custom Search</a>
    </div>
  </div>
</section>
{% include "cta.njk" %}
